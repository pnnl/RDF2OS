sh:QualifiedMaxCountConstraintComponent sh:labelTemplate "No more than {$qualifiedMaxCount} values can have shape {$qualifiedValueShape}" .

sh:UniqueLangConstraintComponent sh:labelTemplate "No language can be used more than once";
  sh:propertyValidator _:node17075;
  dash:localConstraint true .

sh:NotConstraintComponent sh:labelTemplate "Value must not have shape {$not}" .

sh:DatatypeConstraintComponent sh:labelTemplate "Values must have datatype {$datatype}";
  dash:staticConstraint true .

dash:HasValueTarget sh:labelTemplate "All subjects where {$predicate} has value {$object}" .

dash:AllSubjectsTarget sh:labelTemplate "All subjects" .

dash:PrimaryKeyConstraintComponent sh:labelTemplate "The property {?predicate} is the primary key and URIs start with {?uriStart}";
  sh:propertyValidator _:node16978;
