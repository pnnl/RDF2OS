qudtqk:DebyeAngularFrequency qudt:latexSymbol "\\(\\omega_b\\)"^^qudt:LatexString .

qudtqk:EquilibriumConstantOnPressureBasis qudt:latexSymbol "\\(K_p\\)"^^qudt:LatexString .

qudtqk:GyromagneticRatio qudt:latexSymbol "\\(\\gamma\\)"^^qudt:LatexString .

