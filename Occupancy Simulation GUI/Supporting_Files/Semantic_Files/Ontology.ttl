constant:ComptonWavelength qudt:latexSymbol "\\(\\lambda_C\\)"^^qudt:LatexString .

qudtqk:EquilibriumConstantOnConcentrationBasis qudt:latexSymbol "\\(K_c\\)"^^qudt:LatexString .

