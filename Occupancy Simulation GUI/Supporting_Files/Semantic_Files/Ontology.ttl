qudtqk:AverageLogarithmicEnergyDecrement qudt:latexSymbol "\\(\\xi\\)"^^qudt:LatexString .

qudtqk:Polarizability qudt:latexSymbol "\\(\\alpha\\)"^^qudt:LatexString .

qudtqk:DensityInCombustionChamber qudt:latexSymbol "\\(\\rho_c\\)"^^qudt:LatexString .

unit:FT-LB_F-PER-FT2-SEC qudt:latexSymbol "\\(ft \\cdot lbf/(ft^2 \\cdot s)\\)"^^qudt:LatexString .

qudtqk:MolarConductivity qudt:latexSymbol "\\(\\Gamma_m\\)"^^qudt:LatexString .

qudtqk:TotalCurrentDensity qudt:latexSymbol "\\(J_{tot}\\)"^^qudt:LatexString .

qudtqk:DisplacementCurrentDensity qudt:latexSymbol "\\(J_D\\)"^^qudt:LatexString .

qudtqk:RadiativeHeatTransfer qudt:latexSymbol "\\(\\Phi_r\\)"^^qudt:LatexString .

qudtqk:HeatFlowRate qudt:latexSymbol "\\(\\Phi\\)"^^qudt:LatexString .

qudtqk:CharacteristicVelocity qudt:latexSymbol "\\(c^{*}\\)"^^qudt:LatexString .

qudtqk:KinematicViscosity qudt:latexSymbol "\\(\\nu\\)"^^qudt:LatexString .

qudtqk:WorkFunction qudt:latexSymbol "\\(\\Phi\\)"^^qudt:LatexString .

qudtqk:MassOfTheEarth qudt:latexSymbol "\\(M_{\\oplus}\\)"^^qudt:LatexString .

qudtqk:MolarAttenuationCoefficient qudt:latexSymbol "\\(\\mu_c\\)"^^qudt:LatexString .

