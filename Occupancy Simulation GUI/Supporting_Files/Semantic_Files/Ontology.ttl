    "\\(M / (L \\cdot T^2 H)\\)"^^qudt:LatexString .

qudtqk:PressureCoefficient qudt:latexSymbol "\\(\\beta\\)"^^qudt:LatexString .

qudtqk:RelativeMassRatioOfVapour qudt:latexSymbol "\\(\\psi\\)"^^qudt:LatexString .

qudtqk:DebyeTemperature qudt:latexSymbol "\\(\\Theta_D\\)"^^qudt:LatexString .

qudtqk:ElectricChargePerArea qudt:latexSymbol "\\(\\sigma\\)"^^qudt:LatexString .

qudtqk:ElectricChargeDensity qudt:latexSymbol "\\(\\rho\\)"^^qudt:LatexString .

qudtqk:DynamicFrictionCoefficient qudt:latexSymbol "\\(\\mu\\)"^^qudt:LatexString .

qudtqk:FrictionCoefficient qudt:latexSymbol "\\(\\mu\\)"^^qudt:LatexString .

unit:PER-T-M qudt:latexSymbol "\\(m^{-1} \\cdot T^{-1}\\)"^^qudt:LatexString .

qudtqk:ExposureRate qudt:latexSymbol "\\(\\dot{X}\\)"^^qudt:LatexString .

qudtqk:VolumeFraction qudt:latexSymbol "\\(\\varphi_B\\)"^^qudt:LatexString .

qudtqk:MassConcentration qudt:latexSymbol "\\(\\rho_B\\)"^^qudt:LatexString .

qudtqk:Fugacity qudt:latexSymbol "\\(\\tilde{p}_B\\)"^^qudt:LatexString .

qudtqk:LinearStrain qudt:latexSymbol "\\(\\xi\\)"^^qudt:LatexString .

qudtqk:Strain qudt:latexSymbol "\\(\\epsilon\\)"^^qudt:LatexString .

unit:PERMEABILITY_EM_REL qudt:latexSymbol "\\(\\mu\\,T\\)"^^qudt:LatexString .

qudtqk:Admittance qudt:latexSymbol "\\(Y\\)"^^qudt:LatexString .

unit:EV-PER-ANGSTROM qudt:latexSymbol "\\(ev/\\AA\\)"^^qudt:LatexString .

qudtqk:RelativePressureCoefficient qudt:latexSymbol "\\(\\alpha_p\\)"^^qudt:LatexString .

