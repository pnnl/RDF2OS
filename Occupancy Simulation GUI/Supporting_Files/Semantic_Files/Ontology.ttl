_:node20911 sh:select """
SELECT $this ?count
WHERE {  
{ SELECT  $this (COUNT (DISTINCT ?qkdv) AS ?count)
   WHERE 
{
      {
      $this qudt:hasQuantityKind/qudt:hasDimensionVector ?qkdv .
      }
      UNION
      {
      $this qudt:hasUnit/qudt:hasDimensionVector ?qkdv .
      }
}
 GROUP BY $this 
}
FILTER (?count > 1) .
}
""" .

