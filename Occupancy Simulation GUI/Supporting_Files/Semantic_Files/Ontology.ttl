qudtqk:RadiantEnergyDensity qudt:latexSymbol "\\(w, \\rho\\)"^^qudt:LatexString .

unit:N-SEC-PER-M3 qudt:latexSymbol "\\(N \\cdot s \\cdot m^{-3}\\)"^^qudt:LatexString .

constant:MagneticConstant qudt:latexSymbol "\\(\\mu_0\\)"^^qudt:LatexString .

constant:ElectromagneticPermeabilityOfVacuum qudt:latexSymbol "\\(\\mu_0\\)"^^qudt:LatexString .

unit:KiloGM-PER-SEC2 qudt:latexSymbol "\\(kg \\cdot s^2\\)"^^qudt:LatexString .

