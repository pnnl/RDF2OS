dtype:GMD_DTYPE vaem:releaseDate "2023-11-14"^^xsd:date;
  vaem:hasLicenseType voag1:CC-SHAREALIKE_3PT0-US;
  vaem:title "Datatype Schema (DTYPE) - Version 2.1" .

sh:QualifiedMaxCountConstraintComponent-qualifiedValueShapesDisjoint sh:optional true .

sh:QualifiedMinCountConstraintComponent-qualifiedValueShapesDisjoint sh:optional true .

sh:PatternConstraintComponent-flags sh:optional true .

sh:ClosedConstraintComponent-ignoredProperties sh:optional true .

dash:isDeactivated sh:ask """ASK {
    ?constraintOrShape sh:deactivated true .
}""";
  dash:apiStatus dash:Stable .

dash:isLanguageIn sh:ask """
		ASK {
			BIND (lang($value) AS ?valueLang) .
			FILTER EXISTS {
				GRAPH $shapesGraph {
					$languageIn (rdf:rest*)/rdf:first ?lang .
				    FILTER (langMatches(?valueLang, ?lang))
				} }
		}
		""" .

dash:hasNodeKind sh:ask """
		ASK {
			FILTER ((isIRI($value) && $nodeKind IN ( sh:IRI, sh:BlankNodeOrIRI, sh:IRIOrLiteral ) ) ||
				(isLiteral($value) && $nodeKind IN ( sh:Literal, sh:BlankNodeOrLiteral, sh:IRIOrLiteral ) ) ||
				(isBlank($value)   && $nodeKind IN ( sh:BlankNode, sh:BlankNodeOrIRI, sh:BlankNodeOrLiteral ) )) .
		}
		""" .

dash:hasMaxExclusive sh:ask "ASK { FILTER ($value < $maxExclusive) }" .

dash:hasMinExclusive sh:ask "ASK { FILTER ($value > $minExclusive) }" .

dash:isIn sh:ask """
		ASK {
			GRAPH $shapesGraph {
				$in (rdf:rest*)/rdf:first $value .
			}
		}
		""" .

dash:isNodeKindIRI sh:ask """ASK {
	FILTER ($nodeKind IN ( sh:IRI, sh:BlankNodeOrIRI, sh:IRIOrLiteral ))
}""";
  dash:apiStatus dash:Stable;
  dash:cachable true;
  dash:contextFree true .

dash:isNodeKindBlankNode sh:ask """ASK {
	FILTER ($nodeKind IN ( sh:BlankNode, sh:BlankNodeOrIRI, sh:BlankNodeOrLiteral ))
}""";
  dash:apiStatus dash:Stable;
  dash:cachable true;
  dash:contextFree true .

dash:hasClass sh:ask """
		ASK {
			$value rdf:type/rdfs:subClassOf* $class .
		}
		""" .

dash:hasMinLength sh:ask """
		ASK {
			FILTER (STRLEN(str($value)) >= $minLength) .
		}
		""" .

dash:hasStem sh:ask "ASK { FILTER (isIRI($value) && STRSTARTS(str($value), $stem)) }" .

dash:hasMaxInclusive sh:ask "ASK { FILTER ($value <= $maxInclusive) }" .

dash:hasPattern sh:ask "ASK { FILTER (!isBlank($value) && IF(bound($flags), regex(str($value), $pattern, $flags), regex(str($value), $pattern))) }" .

dash:hasRootClass sh:ask """ASK {
    $value rdfs:subClassOf* $rootClass .
}""" .

dash:isNodeKindLiteral sh:ask """ASK {
	FILTER ($nodeKind IN ( sh:Literal, sh:BlankNodeOrLiteral, sh:IRIOrLiteral ))
}""";
  dash:apiStatus dash:Stable;
  dash:cachable true;
  dash:contextFree true .

dash:hasMaxLength sh:ask """
		ASK {
			FILTER (STRLEN(str($value)) <= $maxLength) .
		}
		""" .

dash:hasMinInclusive sh:ask "ASK { FILTER ($value >= $minInclusive) }" .

dash:isSubClassOf sh:ask """ASK {
    $subclass rdfs:subClassOf* $superclass .
}""";
  dash:apiStatus dash:Stable .

_:node16979 sh:ask """ASK {
    FILTER (!$singleLine || !isLiteral($value) || (!contains(str($value), '\\n') && !contains(str($value), '\\r')))
}""" .

_:node16985 sh:ask """ASK {
    $this $subSetOf $value .
}""" .

_:node17066 sh:ask """
		ASK {
			FILTER NOT EXISTS {
				$this $disjoint $value .
			}
		}
		""" .

_:node17069 sh:ask """ASK {
    FILTER ($value = $hasValue)
}""" .

<http://www.w3.org/ns/shacl#> sh:suggestedShapesGraph <http://www.w3.org/ns/shacl-shacl#> .

